// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Mailstream Flutter

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = dev.mailstream.MailstreamFlutter

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 dev.mailstream. All rights reserved.

// Approved public signing trust anchor. Never place the private key in this file.
// Local/test builders may override the public configuration below.
MAILSTREAM_UPDATE_PUBLIC_KEY = eIwn7DyQN0GOIdjlzo6AKRm5GVCOorozSzfbC+4XG4s=
// Current distributions are prereleases. Stable builders override this explicitly.
MAILSTREAM_UPDATE_CHANNEL = prerelease
// The signed updates feed is published independently of the ad-hoc nightly.
// Escape // so xcconfig does not treat the HTTPS URL as a comment.
MAILSTREAM_UPDATE_FEED_URL = https:/$()/github.com/taooceros/mailstream/releases/download/updates/appcast.xml
#include? "Updates.local.xcconfig"
